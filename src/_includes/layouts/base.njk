<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ documentTitle or title or site.title }}</title>
    {#- A project page and its docs wear the project's own mark in the tab, so a
        reader with several open can tell them apart. `project` is an object on
        a project page and the slug string on a docs page, hence the fallback
        chain. A project whose mark is not drawn keeps the site favicon. -#}
    {%- set markSlug = project.slug or project %}
    {%- if markSlug and markSlug in projectMarks %}
    <link rel="icon" href="/images/marks/{{ markSlug }}.png" type="image/png">
    {%- else %}
    {#- The SVG is listed first so a browser that reads it never reaches the
        rasters. It carries its own prefers-color-scheme rule and repaints
        itself; Safari takes the light rule and ignores the query, which is
        what the PNG and ICO are here for. The mark carries no brand colour
        yet, by decision: coilyco-bridge/agentic-os-xxx#7074. -#}
    <link rel="icon" href="/images/favicon.svg" type="image/svg+xml">
    <link rel="icon" href="/images/favicon-32.png" type="image/png" sizes="32x32">
    <link rel="icon" href="/images/favicon-16.png" type="image/png" sizes="16x16">
    <link rel="icon" href="/images/favicon.ico" type="image/x-icon">
    {%- endif %}
    <link rel="stylesheet" href="/styles/prism-tomorrow.css">
    <link rel="stylesheet" href="/styles/site.css">
    <link rel="alternate" type="application/atom+xml" title="{{ site.title }}" href="{{ site.url }}/feed.xml">
    <meta name="description" content="{{ description or site.description }}">
    <meta name="robots" content="{{ robots or 'noindex, nofollow' }}">
    <meta property="og:title" content="{{ title or site.title }}">
    <meta property="og:description" content="{{ description or site.description }}">
    <meta property="og:type" content="{% if isArticle %}article{% else %}website{% endif %}">
    {% if canonical %}
      {%- set canonUrl = canonical | canonicalUrl %}
      <link rel="canonical" href="{{ canonUrl }}">
      <meta property="og:url" content="{{ canonUrl }}">
    {% endif %}
    {% if isArticle and date %}
      <meta property="article:published_time" content="{{ date | isoDate }}">
      <meta property="article:author" content="Kai Ase Siren">
    {% endif %}
    <meta property="og:image" content="{{ site.url }}{{ ogImage or site.ogImage }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="{{ ogImageAlt or site.ogImageAlt }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ title or site.title }}">
    <meta name="twitter:description" content="{{ description or site.description }}">
    <meta name="twitter:image" content="{{ site.url }}{{ ogImage or site.ogImage }}">
    {% if isArticle and date %}
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "BlogPosting",
          "headline": {{ title | dump | safe }},
          "datePublished": {{ date | isoDay | dump | safe }},
          "url": {{ (canonical | canonicalUrl) | dump | safe }},
          "author": {
            "@type": "Person",
            "name": {{ site.author | dump | safe }},
            "url": {{ site.url | dump | safe }}
          }
        }
      </script>
    {% endif %}
    {% if softwareSchema %}
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "SoftwareSourceCode",
          "name": {{ softwareSchema.name | dump | safe }},
          "description": {{ softwareSchema.claim | dump | safe }},
          "url": {{ (canonical | canonicalUrl) | dump | safe }},
          "codeRepository": {{ softwareSchema.repo | dump | safe }},
          "license": {{ softwareSchema.license | dump | safe }},
          "author": {
            "@type": "Person",
            "name": {{ site.author | dump | safe }},
            "url": {{ site.url | dump | safe }}
          }
        }
      </script>
    {% endif %}
    {% if docsSchema %}
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "TechArticle",
          "headline": {{ docsSchema.headline | dump | safe }},
          "description": {{ description | dump | safe }},
          "url": {{ (canonical | canonicalUrl) | dump | safe }},
          "articleSection": {{ docsSchema.shelf | dump | safe }},
          "isPartOf": {
            "@type": "SoftwareSourceCode",
            "name": {{ project | dump | safe }},
            "url": {{ (site.url + projectPage) | dump | safe }}
          },
          "author": {
            "@type": "Person",
            "name": {{ site.author | dump | safe }},
            "url": {{ site.url | dump | safe }}
          }
        }
      </script>
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": {{ project | dump | safe }},
              "item": {{ (site.url + projectPage) | dump | safe }}
            },
            {
              "@type": "ListItem",
              "position": 2,
              "name": "Docs",
              "item": {{ (site.url + projectPage + "docs/") | dump | safe }}
            },
            {
              "@type": "ListItem",
              "position": 3,
              "name": {{ docsSchema.headline | dump | safe }},
              "item": {{ (site.url + canonical) | dump | safe }}
            }
          ]
        }
      </script>
    {% endif %}
    {% if personSchema %}
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "Person",
          "name": {{ site.author | dump | safe }},
          "url": {{ site.url | dump | safe }},
          "jobTitle": {{ site.jobTitle | dump | safe }},
          "sameAs": {{ site.sameAs | dump | safe }}
        }
      </script>
    {% endif %}
  </head>
  <body>
    <div class="layoutWrapper">
      {%- if variant == "vanity" %}
      {% include "components/nav-vanity.njk" %}
      <main>{{ content | safe }}</main>
      {% include "components/footer-vanity.njk" %}
      {%- else %}
      {% include "components/nav.njk" %}
      <main>{{ content | safe }}</main>
      {% include "components/footer.njk" %}
      {%- endif %}
    </div>
  </body>
</html>
