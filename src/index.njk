---
layout: layouts/base.njk
permalink: index.html
description: Kai Ase Siren builds governed agent systems, developer infrastructure, and the platform layer underneath.
canonical: /
robots: follow, index
personSchema: true
---
<div class="portfolio-home">
  <header class="portfolio-hero">
    <div class="portfolio-hero__copy">
      <h1>Directing the agentic engineering platform</h1>
    </div>
    <ul class="portfolio-hero__team">
      {% for seat in roster %}
        <li class="roster-seat">
          <img
            class="roster-seat__creature"
            src="/images/creatures/{{ seat.slug }}.png"
            width="200"
            height="200"
            alt="{{ seat.name }}, the {{ seat.title | lower }} creature"
            decoding="async"
          >
          <p class="roster-seat__name">{{ seat.name }}</p>
          <p class="roster-seat__title">{{ seat.title }}</p>
        </li>
      {% endfor %}
    </ul>
    <aside class="portfolio-hero__portrait">
      <div class="portrait-frame">
        <img src="/images/headshot.jpg" alt="Kai Ase Siren">
      </div>
      <div class="portfolio-hero__signature">
        <p class="portfolio-hero__name">Kai Ase Siren</p>
        {#- Lifted verbatim from the bolded one-line summary at the top of
            src/pages/resume.md, so the hero and the resume cannot drift. -#}
        <p class="portfolio-hero__standfirst">
          Senior platform engineer building governed AI systems and developer
          infrastructure.
        </p>
      </div>
    </aside>
  </header>
  <section id="products" class="product-showcase">
    <div class="product-showcase__inner">
      <div class="section-heading">
        <h2>Projects</h2>
      </div>
      <ul class="product-showcase__grid">
        {% for product in showcase %}
          <li
            class="product-tile{% if not product.banner %} product-tile--wide{% endif %}"
            data-product="{{ product.slug }}"
          >
            <div class="product-tile__surface{% if product.privateRepo %} product-tile__surface--private{% endif %}">
              {% set destination = product.page or product.url %}
              {% if destination %}
                <a class="product-tile__link" href="{{ destination }}">
              {% endif %}
              {% if product.banner %}
                {% if product.mobileBanner %}
                  <picture class="product-tile__picture product-tile__picture--responsive">
                    <source
                      media="(max-width: 600px)"
                      srcset="{{ product.mobileBanner }} 1280w, {{ product.mobileBanner2x }} 2560w"
                      sizes="92vw"
                    >
                {% endif %}
                <img
                  class="product-tile__banner"
                  src="{{ product.banner }}"
                  srcset="{{ product.banner }} 1280w, {{ product.banner2x }} 2560w"
                  sizes="(min-width: 900px) 45vw, 92vw"
                  width="1280"
                  height="492"
                  alt="{{ product.alt }}"
                  loading="lazy"
                  decoding="async"
                >
                {% if product.mobileBanner %}
                  </picture>
                {% endif %}
              {% else %}
                <span class="product-tile__plate">
                  <span class="product-tile__stage">{{ product.stage }}</span>
                  <span class="product-tile__wordmark">{{ product.wordmark }}</span>
                  <span class="product-tile__claim">{{ product.claim }}</span>
                </span>
              {% endif %}
              {% if destination %}
                </a>
              {% endif %}
              <p class="product-tile__proof">{{ product.proof }}</p>
              <p class="product-tile__links">
                {% if product.page %}
                  <a href="{{ product.page }}">Read the case →</a>
                {% elif product.url %}
                  <a href="{{ product.url }}">Source ↗</a>
                {% else %}
                  <small>Private repository</small>
                {% endif %}
                {#- Only a project whose docs are actually mounted, so the link
                    cannot promise a section that does not exist. -#}
                {% if docsMounts[product.slug] %}
                  <a class="product-tile__docs" href="{{ docsMounts[product.slug].root }}">Docs</a>
                {% endif %}
              </p>
            </div>
          </li>
        {% endfor %}
      </ul>
    </div>
  </section>
  <section id="demo" class="talk-showcase" aria-label="Demos">
    <div class="talk-showcase__inner">
      <p class="section-label">Demo</p>
      <div class="talk-showcase__reel">
        <article class="talk-showcase__clip" aria-labelledby="demo-path-shadowing">
          <div class="section-heading">
            <h2 id="demo-path-shadowing">Sprite asks Vera to deploy the crab nebula</h2>
          </div>
          <div class="talk-showcase__player talk-showcase__player--video">
            {#- Both clips are click-to-play in the markup, so their bytes stay
                off the first load. demo-reel.js turns each into a loop once it
                scrolls into view. Muted and playsinline are both required, or
                iOS refuses to play them unprompted. -#}
            <video
              class="demo-player"
              src="/images/demo/path-shadowing.mp4"
              poster="/images/demo/path-shadowing-poster.jpg"
              width="1280"
              height="832"
              controls
              muted
              loop
              playsinline
              preload="none"
              data-play-in-view
              aria-label="A title card reads twenty minutes of crab on crab combat. Sprite's game developer session checking a galaxy-gen pull request fades into Vera's systems administrator session, which finds two rustc installs shadowing each other on PATH and lands the fix, and the galaxy renders."
            ></video>
          </div>
        </article>
        <article class="talk-showcase__clip" aria-labelledby="demo-beaver">
          <div class="section-heading">
            <h2 id="demo-beaver">Delphi shows me a sick ass beaver</h2>
          </div>
          <div class="talk-showcase__player talk-showcase__player--video">
            <video
              class="demo-player"
              src="/images/demo/beaver.mp4"
              poster="/images/demo/beaver-poster.jpg"
              width="1280"
              height="832"
              controls
              muted
              loop
              playsinline
              preload="none"
              data-play-in-view
              aria-label="An agent session splits its terminal window in half and renders a photograph of a beaver in the new pane, then closes it again."
            ></video>
          </div>
        </article>
      </div>
    </div>
    <script src="/demo-reel.js" defer></script>
  </section>
</div>
